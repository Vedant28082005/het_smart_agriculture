# Copy to .env and edit.
CORS_ORIGINS=http://localhost:5173
DB_PATH=irrigation.db

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=farm/field1

# ESP32 HTTP command channel (mDNS name or static IP) and its API key (from secrets.h)
DEVICE_HOST=irrigation.local
DEVICE_API_KEY=change-me
DEVICE_TIMEOUT_S=4

# Seconds without data before the device counts as offline
OFFLINE_AFTER_S=30

# DEMO=1 runs a built-in fake device (no ESP32 or broker needed) for trying the dashboard
DEMO=0
